# www.healthclass.app · environment. Copy to .env.local for local work; set the same keys in Vercel.

# Convex (npx convex dev writes these two for local work; in Vercel, use the production deployment's URL)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# a long random string, the same value in Vercel and in Convex (npx convex env set HC_SERVER_SECRET ...)
HC_SERVER_SECRET=

# Q&A sign-in emails (Resend). Empty: the link is written to the server log instead.
RESEND_API_KEY=
QA_FROM_EMAIL="Dr. Dana at Health Class <dana@healthclass.app>"

# optional: the store pages, if you prefer env over lib/site.ts (used by the healthclass.app magic link)
APP_STORE_URL=
PLAY_STORE_URL=

# Set on Convex, not here (npx convex env set NAME value):
#   HC_SERVER_SECRET       same as above
#   MAILCHEAP_API_KEY      MailCheap API key (a signups-only key is enough). Empty: signups wait in Convex.
#   MAILCHEAP_NEWSLETTER   optional: the MailCheap newsletter id or slug
#   SUPERWALL_WEBHOOK_KEY  the ?key= on the Superwall webhook URL
#   HC_ADMIN_TOKEN         for POST /members (manual member fixes)
